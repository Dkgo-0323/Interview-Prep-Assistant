# Alibaba Cloud Model Studio / DashScope (OpenAI-compatible API)
DASHSCOPE_API_KEY=your-dashscope-api-key-here
LLM_BASE_URL=https://your-workspace-id.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
LLM_DEFAULT_MODEL=qwen3.7-plus
LLM_MODEL_JD_EXTRACTION=qwen3.7-plus
LLM_MODEL_RESUME_EXTRACTION=qwen3.7-plus
LLM_MODEL_GAP_ANALYSIS=qwen3.7-plus
LLM_MODEL_QUESTION_GENERATION=qwen3.7-plus
LLM_PROVIDER=qwen
LLM_TIMEOUT_SECONDS=120
LLM_ENABLE_THINKING=false

# Sampling/output defaults. Structured calls intentionally do not send a token
# limit because truncated JSON cannot be parsed safely.
TEMPERATURE=0.7
MAX_TOKENS=2000

# Configure the current Qwen prices for your region/account in USD per 1M tokens.
LLM_INPUT_COST_USD_PER_MILLION_TOKENS=
LLM_OUTPUT_COST_USD_PER_MILLION_TOKENS=
